<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="INTELLIGENT DEAD RECKONING"
            android:textColor="#38BDF8"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ISRO SIH - Data Collector"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:gravity="center"
            android:paddingBottom="12dp" />

        <!-- Sensor Frequency Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="8dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sensor Frequency"
                    android:textColor="#CBD5E1"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:paddingBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnFreq1Hz"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="1 Hz"
                        android:textSize="12sp"
                        android:backgroundTint="#334155"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnFreq10Hz"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="10 Hz"
                        android:textSize="12sp"
                        android:backgroundTint="#0EA5E9"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnFreq50Hz"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="50 Hz"
                        android:textSize="12sp"
                        android:backgroundTint="#334155"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnFreq100Hz"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="100 Hz"
                        android:textSize="12sp"
                        android:backgroundTint="#334155"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSelectedFrequency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selected frequency: 10 Hz"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:paddingTop="6dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Stream Control Buttons Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="8dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Streams"
                    android:textColor="#CBD5E1"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:paddingBottom="8dp" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:rowCount="2">

                    <Button
                        android:id="@+id/btnStartSensor"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="START SENSOR"
                        android:textSize="11sp"
                        android:backgroundTint="#10B981"
                        android:textColor="#FFFFFF"
                        android:layout_margin="2dp"/>

                    <Button
                        android:id="@+id/btnStartGnss"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="START GNSS"
                        android:textSize="11sp"
                        android:backgroundTint="#F59E0B"
                        android:textColor="#FFFFFF"
                        android:layout_margin="2dp"/>

                    <Button
                        android:id="@+id/btnStartCellular"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="START CELLULAR"
                        android:textSize="11sp"
                        android:backgroundTint="#6366F1"
                        android:textColor="#FFFFFF"
                        android:layout_margin="2dp"/>

                    <Button
                        android:id="@+id/btnStartAll"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="START ALL STREAMS"
                        android:textSize="11sp"
                        android:backgroundTint="#EC4899"
                        android:textColor="#FFFFFF"
                        android:layout_margin="2dp"/>
                </GridLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Session Counters Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="8dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SESSION"
                    android:textColor="#CBD5E1"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:paddingBottom="4dp" />

                <TextView
                    android:id="@+id/tvSessionId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Session ID: INACTIVE"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:paddingBottom="6dp" />

                <TextView
                    android:id="@+id/tvSensorEventsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sensor events: 0"
                    android:textColor="#10B981"
                    android:textSize="13sp"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/tvGnssFixesCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GNSS fixes: 0"
                    android:textColor="#F59E0B"
                    android:textSize="13sp"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/tvSatelliteRecordsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Satellite records: 0"
                    android:textColor="#38BDF8"
                    android:textSize="13sp"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/tvCellRecordsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cell records: 0"
                    android:textColor="#A855F7"
                    android:textSize="13sp"
                    android:fontFamily="monospace" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Compact Cellular Status Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="8dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CELLULAR"
                    android:textColor="#A855F7"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:paddingBottom="6dp" />

                <TextView
                    android:id="@+id/tvCellularStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Status: STOPPED\nTechnology: N/A\nServing Cell ID: N/A\nPCI: N/A\nRSRP: N/A\nARFCN: N/A\nTAC: N/A"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp"
                    android:fontFamily="monospace" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- GNSS Status Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="8dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GNSS / GPS"
                    android:textColor="#F59E0B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:paddingBottom="6dp" />

                <TextView
                    android:id="@+id/tvGnssStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Status: STOPPED\nFix: WAITING / NO FIX\nLat: N/A | Lng: N/A\nAlt: N/A | Acc: N/A\nSatellites: 0 in view (0 in fix)"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp"
                    android:fontFamily="monospace" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Neighbor Cells View Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="8dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NEIGHBOR CELLS"
                    android:textColor="#10B981"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:paddingBottom="6dp" />

                <TextView
                    android:id="@+id/tvNeighborCellsDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No neighbor cells detected."
                    android:textColor="#CBD5E1"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
